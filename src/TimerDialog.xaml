<Window x:Class="DynamicIsland.TimerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus timer" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Base Close Icon Button -->
        <Style x:Key="CloseIconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#8E95A8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="17" BorderThickness="1.2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#222634" Offset="0"/>
                                    <GradientStop Color="#141722" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3D445C" Offset="0"/>
                                    <GradientStop Color="#1F2332" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#363C52" Offset="0"/>
                                            <GradientStop Color="#202434" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#10121A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stepper Minus / Plus Button -->
        <Style x:Key="StepperBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#E2E6F5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="26" BorderThickness="1.2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#272B3C" Offset="0"/>
                                    <GradientStop Color="#171924" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4A526E" Offset="0"/>
                                    <GradientStop Color="#202434" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.30"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#373D55" Offset="0"/>
                                            <GradientStop Color="#242838" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#85FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#13151F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Chip Button -->
        <Style x:Key="PresetChip" TargetType="Button">
            <Setter Property="Foreground" Value="#BAC0D2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="20" BorderThickness="1.2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1C1F2B" Offset="0"/>
                                    <GradientStop Color="#13151F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3A4056" Offset="0"/>
                                    <GradientStop Color="#232736" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Foreground" Value="#FFAE34"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#4E2604" Offset="0"/>
                                            <GradientStop Color="#2E1302" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#FFA820"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" Color="#FFA000" Opacity="0.45" ShadowDepth="1" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#75FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#12141C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Cancel Button with Specular Arc -->
        <Style x:Key="CancelBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#D6DAEA"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="26" BorderThickness="1.2" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#282C3D" Offset="0"/>
                                    <GradientStop Color="#181B26" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#50FFFFFF" Offset="0"/>
                                    <GradientStop Color="#18FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                            </Border.Effect>

                            <Grid>
                                <!-- Top Specular Sheen Arc -->
                                <Border Height="26" VerticalAlignment="Top" CornerRadius="26,26,40,40" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3B425A" Offset="0"/>
                                            <GradientStop Color="#252A3B" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#85FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#12141C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vibrant High-Performance Solar Amber Start Button -->
        <Style x:Key="PrimaryStartBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#140900"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="26" BorderThickness="1.2" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFB72B" Offset="0"/>
                                    <GradientStop Color="#FF8000" Offset="0.5"/>
                                    <GradientStop Color="#E64A00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFCE0" Offset="0"/>
                                    <GradientStop Color="#FFA726" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Grid>
                                <!-- Top Specular Sheen Arc -->
                                <Border Height="26" VerticalAlignment="Top" CornerRadius="26,26,40,40" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.97"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="42">
        <!-- ==================== AMBIENT AURA GLOW LAYER (Behind Card) ==================== -->
        <!-- Multi-stop zero-cost native radial gradient without expensive software BlurEffect -->
        <Ellipse x:Name="AmbientAura" Width="380" Height="260" Margin="0,-40,0,0"
                 VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.4" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#40FF8C00" Offset="0.0"/>
                    <GradientStop Color="#26FF6600" Offset="0.28"/>
                    <GradientStop Color="#12FF5500" Offset="0.58"/>
                    <GradientStop Color="#04FF4400" Offset="0.82"/>
                    <GradientStop Color="#00FF4400" Offset="1.0"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ==================== MAIN CARD ==================== -->
        <Border x:Name="Card" Width="416" CornerRadius="32" BorderThickness="1.2" Padding="28,26,28,28">
            <!-- Multi-stop Dark Luxury Glass Gradient -->
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.85,1">
                    <GradientStop Color="#D0202636" Offset="0"/>
                    <GradientStop Color="#C0131722" Offset="0.25"/>
                    <GradientStop Color="#B40D0F17" Offset="0.65"/>
                    <GradientStop Color="#C207080D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <!-- Precision Specular Glass Rim Border -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                    <GradientStop Color="#95FFFFFF" Offset="0"/>
                    <GradientStop Color="#50FFA825" Offset="0.22"/>
                    <GradientStop Color="#24FFFFFF" Offset="0.55"/>
                    <GradientStop Color="#12FFFFFF" Offset="0.85"/>
                    <GradientStop Color="#06FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <!-- Deep Cinematic Occlusion Drop Shadow -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale"/>
                    <TranslateTransform x:Name="CardShift"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <!-- Subtle Warm Amber Light-Bleed Reflection at Top-Left -->
                <Border CornerRadius="32" Margin="-28,-26,-28,-28" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.14,0.06" RadiusX="0.75" RadiusY="0.55">
                            <GradientStop Color="#24FF9500" Offset="0"/>
                            <GradientStop Color="#0CFF9500" Offset="0.45"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Specular Curved Top Glass Reflection Arc -->
                <Border Height="65" VerticalAlignment="Top" CornerRadius="32,32,100,100" Margin="-27,-25,-27,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#18FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Dialog Content -->
                <StackPanel>
                    <!-- ==================== HEADER ==================== -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Amber Badge Icon with Breathing Ring & Living Pulse -->
                            <Border x:Name="HeaderBadge" Width="44" Height="44" CornerRadius="22" BorderThickness="1.2"
                                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="HeaderBadgeScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFA726" Offset="0"/>
                                        <GradientStop Color="#FF7A00" Offset="0.55"/>
                                        <GradientStop Color="#E65100" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFF0AA" Offset="0"/>
                                        <GradientStop Color="#FFA000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#FF7700" Opacity="0.45"/>
                                </Border.Effect>
                                <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="19"
                                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Focus timer" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="How long do you want to focus?" Foreground="#959DB4" FontSize="12.8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button with Micro-Rotation Animation -->
                        <Button x:Name="CloseBtn" Style="{StaticResource CloseIconBtn}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                FontFamily="{StaticResource Icons}" FontSize="11" Content="&#xE711;"
                                AutomationProperties.Name="Close" RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CloseScale" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="CloseRot" Angle="0"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                    </Grid>

                    <!-- ==================== STEPPER AREA ==================== -->
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Minus Button (-1 min) -->
                        <Button x:Name="Minus" Style="{StaticResource StepperBtn}"
                                FontFamily="{StaticResource Icons}" FontSize="16" Content="&#xE738;"
                                AutomationProperties.Name="1 minute less"/>

                        <!-- Center Digits & Estimated End Time -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Number + Ambient Glow behind it -->
                            <Grid HorizontalAlignment="Center">
                                <!-- Ambient Number Dial Glow -->
                                <Ellipse x:Name="NumAura" Width="140" Height="75" Margin="0,-5,0,0"
                                         VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Opacity="0.30">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#28FFA000" Offset="0"/>
                                            <GradientStop Color="#00FFA000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="Num" Foreground="#FFFFFF" FontSize="62" FontWeight="Bold"
                                               Typography.NumeralAlignment="Tabular" RenderTransformOrigin="0.5,0.6">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.35"/>
                                        </TextBlock.Effect>
                                        <TextBlock.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="NumScale" ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="NumShift" X="0" Y="0"/>
                                            </TransformGroup>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Text="min" Foreground="#AAB1C7" FontSize="16.5" FontWeight="SemiBold"
                                               VerticalAlignment="Bottom" Margin="7,0,0,13"/>
                                </StackPanel>
                            </Grid>

                            <!-- End Time Pill with Live Indicator Dot -->
                            <Border x:Name="EndsPill" Background="#161824" BorderBrush="#262B3D" BorderThickness="1"
                                    CornerRadius="13" Padding="12,5" Margin="0,3,0,0" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Live Indicator Dot -->
                                    <Ellipse x:Name="LiveDot" Width="6" Height="6" Fill="#FFA500" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource Icons}" FontSize="11"
                                               Foreground="#FFA825" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="EndsText" Foreground="#A2A9C0" FontSize="12.5" FontWeight="Medium"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Plus Button (+1 min) -->
                        <Button x:Name="Plus" Grid.Column="2" Style="{StaticResource StepperBtn}"
                                FontFamily="{StaticResource Icons}" FontSize="16" Content="&#xE710;"
                                AutomationProperties.Name="1 minute more"/>
                    </Grid>

                    <!-- ==================== SLIDER TRACK ==================== -->
                    <Grid x:Name="TrackHit" Height="36" Margin="0,22,0,0" Background="Transparent" Cursor="Hand">
                        <!-- Trench Groove -->
                        <Border Height="9" CornerRadius="4.5" BorderThickness="1" VerticalAlignment="Center"
                                Background="#12141D" BorderBrush="#22FFFFFF"/>

                        <!-- Fill Bar -->
                        <Border x:Name="Fill" Height="9" CornerRadius="4.5" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FF4500" Offset="0"/>
                                    <GradientStop Color="#FF8800" Offset="0.35"/>
                                    <GradientStop Color="#FFA800" Offset="0.75"/>
                                    <GradientStop Color="#FFD54F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FF8400" Opacity="0.50"/>
                            </Border.Effect>

                            <!-- Glowing Jewel Thumb -->
                            <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-12,0" Width="24" Height="24"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                                </Grid.RenderTransform>
                                <!-- Glowing Outer Halo -->
                                <Ellipse x:Name="ThumbHalo" Width="24" Height="24" Fill="#35FFA000" Opacity="0.7"/>
                                <!-- White Disc with Amber Rim -->
                                <Ellipse Width="18" Height="18" Fill="#FFFFFF" Stroke="#FFA825" StrokeThickness="2.5">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#FFA000" Opacity="0.50"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <!-- Amber Core -->
                                <Ellipse Width="6" Height="6" Fill="#FF7700"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== PRESET CHIPS ==================== -->
                    <TextBlock Text="Quick picks" Foreground="#8B92A8" FontSize="12.5" FontWeight="SemiBold" Margin="2,16,0,9"/>
                    <UniformGrid Columns="5">
                        <Button x:Name="C0" Style="{StaticResource PresetChip}" Margin="0,0,4,0"/>
                        <Button x:Name="C1" Style="{StaticResource PresetChip}" Margin="2,0"/>
                        <Button x:Name="C2" Style="{StaticResource PresetChip}" Margin="2,0"/>
                        <Button x:Name="C3" Style="{StaticResource PresetChip}" Margin="2,0"/>
                        <Button x:Name="C4" Style="{StaticResource PresetChip}" Margin="4,0,0,0"/>
                    </UniformGrid>

                    <!-- ==================== ACTION BUTTONS (Start & Cancel) ==================== -->
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="106"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cancel Button with Glass Aesthetics -->
                        <Button x:Name="CancelBtn" Style="{StaticResource CancelBtnStyle}" Content="Cancel"/>

                        <!-- Living Primary Start Focus Button with Shimmer Light Ray & Amber Halo -->
                        <Button x:Name="StartBtn" Grid.Column="2" Style="{StaticResource PrimaryStartBtnStyle}">
                            <Button.Effect>
                                <DropShadowEffect x:Name="StartGlow" BlurRadius="18" ShadowDepth="3" Direction="270" Color="#FF7A00" Opacity="0.55"/>
                            </Button.Effect>
                            <Grid ClipToBounds="True" Height="52" VerticalAlignment="Center">
                                <!-- Living Angled Shimmer Light Beam -->
                                <Border x:Name="StartShimmer" Width="60" Height="52" HorizontalAlignment="Left" Margin="-80,0,0,0"
                                        IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform AngleX="-24"/>
                                            <TranslateTransform x:Name="StartShimmerShift" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#45FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Text & Animated Play Icon -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="StartIcon" Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="15"
                                               VerticalAlignment="Center" Margin="0,1,8,0" FontWeight="Bold">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="StartIconShift" X="0" Y="0"/>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock Text="Start focus" VerticalAlignment="Center" FontSize="15.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
