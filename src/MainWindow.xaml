<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Dynamic Island"
        Width="440" Height="160"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Display, Segoe UI Semibold, Segoe UI"
        TextOptions.TextRenderingMode="Grayscale" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="False">

    <Window.Resources>
        <!-- Flat round icon button used for prev / play-pause / next.
             44x44 hit target (touch/pointer minimum). -->
        <Style x:Key="Ctl" TargetType="Button">
            <Setter Property="local:Tactile.Enabled" Value="True"/>
            <Setter Property="local:Tactile.HoverScale" Value="1.08"/>
            <Setter Property="local:Tactile.PressScale" Value="0.84"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Window never takes focus (WS_EX_NOACTIVATE), so no focus visuals needed -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="22" BorderThickness="1.2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22FFFFFF" Offset="0"/>
                                    <GradientStop Color="#0DFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#65FFFFFF" Offset="0"/>
                                    <GradientStop Color="#18FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                            <GradientStop Color="#1EFFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B5FFFFFF" Offset="0"/>
                                            <GradientStop Color="#45FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#60A5FA" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#55FFFFFF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#E0FFFFFF"/>
                                <!-- press: quick squish; release: springy return -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat Media Icon Button (Shuffle, Prev, Next, Repeat) -->
        <Style x:Key="MediaIconBtn" TargetType="Button">
            <Setter Property="local:Tactile.Enabled" Value="True"/>
            <Setter Property="local:Tactile.HoverScale" Value="1.14"/>
            <Setter Property="local:Tactile.PressScale" Value="0.88"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Distinctive Circular White Play/Pause Button (OLED Hardware Specular Pop) -->
        <Style x:Key="MediaPlayCircleBtn" TargetType="Button">
            <Setter Property="local:Tactile.Enabled" Value="True"/>
            <Setter Property="local:Tactile.HoverScale" Value="1.06"/>
            <Setter Property="local:Tactile.PressScale" Value="0.90"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circleBg" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                CornerRadius="18"
                                Background="#FFFFFF" BorderThickness="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270" Opacity="0.30" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circleBg" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circleBg" Property="Background" Value="#E5E5EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- High-Precision Luxury Capsule Button for Clipboard History (BMW/Apple/Ferrari inspired) -->
        <Style x:Key="HistoryPillBtnStyle" TargetType="Button">
            <Setter Property="local:Tactile.Enabled" Value="True"/>
            <Setter Property="local:Tactile.HoverScale" Value="1.04"/>
            <Setter Property="local:Tactile.PressScale" Value="0.93"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder" CornerRadius="14" BorderThickness="1.2"
                                Padding="11,0" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                    <GradientStop Color="#5536445E" Offset="0"/>
                                    <GradientStop Color="#3D232C3E" Offset="0.38"/>
                                    <GradientStop Color="#2A161E2C" Offset="0.75"/>
                                    <GradientStop Color="#22101622" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                    <GradientStop Color="#90FFFFFF" Offset="0"/>
                                    <GradientStop Color="#3870B0" Offset="0.35"/>
                                    <GradientStop Color="#20FFFFFF" Offset="0.75"/>
                                    <GradientStop Color="#0EFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="pillScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                            <GradientStop Color="#4D5A7A" Offset="0"/>
                                            <GradientStop Color="#323C52" Offset="0.38"/>
                                            <GradientStop Color="#202737" Offset="0.75"/>
                                            <GradientStop Color="#171C27" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="pillBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                            <GradientStop Color="#D5FFFFFF" Offset="0"/>
                                            <GradientStop Color="#60A5FA" Offset="0.35"/>
                                            <GradientStop Color="#50FFFFFF" Offset="0.75"/>
                                            <GradientStop Color="#25FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="pillBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Direction="270" Opacity="0.55" Color="#0A84FF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pillBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141720" Offset="0"/>
                                            <GradientStop Color="#0D0E14" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="pillBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                            <GradientStop Color="#15FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tactile Glass Round Action Button for Quick-Copy -->
        <Style x:Key="QuickCopyTactileBtnStyle" TargetType="Button">
            <Setter Property="local:Tactile.Enabled" Value="True"/>
            <Setter Property="local:Tactile.HoverScale" Value="1.08"/>
            <Setter Property="local:Tactile.PressScale" Value="0.88"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="circBorder" CornerRadius="17" BorderThickness="1.2"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                    <GradientStop Color="#55384868" Offset="0"/>
                                    <GradientStop Color="#3D243048" Offset="0.4"/>
                                    <GradientStop Color="#2A162032" Offset="0.8"/>
                                    <GradientStop Color="#220F1624" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                    <GradientStop Color="#85FFFFFF" Offset="0"/>
                                    <GradientStop Color="#3570B0" Offset="0.35"/>
                                    <GradientStop Color="#20FFFFFF" Offset="0.75"/>
                                    <GradientStop Color="#0EFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="circScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                            <GradientStop Color="#4F5D7E" Offset="0"/>
                                            <GradientStop Color="#343E55" Offset="0.4"/>
                                            <GradientStop Color="#22293A" Offset="0.8"/>
                                            <GradientStop Color="#181D29" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="circBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                            <GradientStop Color="#D0FFFFFF" Offset="0"/>
                                            <GradientStop Color="#60A5FA" Offset="0.35"/>
                                            <GradientStop Color="#45FFFFFF" Offset="0.75"/>
                                            <GradientStop Color="#20FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="circBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Direction="270" Opacity="0.55" Color="#0A84FF"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#141720" Offset="0"/>
                                            <GradientStop Color="#0D0E14" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="circBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                            <GradientStop Color="#15FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The island is DRAWN, not laid out: a vector shape whose rectangle is animated.
         No layout pass per frame, no pixel snapping, so motion stays smooth.
         Hover events sit on Root so moving from the shape onto a button is not a "leave".
         Fully transparent window area around the island is click-through. -->
    <Grid x:Name="Root" MouseEnter="OnIslandEnter" MouseLeave="OnIslandLeave">

        <!-- Solid black island -->
        <Path x:Name="IslandShape" Width="440" Height="160" RenderTransformOrigin="0.5,0.203125"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Fill="Black" StrokeThickness="1">
            <Path.RenderTransform><ScaleTransform x:Name="IslandBreathScale"/></Path.RenderTransform>
            <Path.Stroke>
                <!-- Glass rim: bright specular top edge, faint at the bottom -->
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#99FFFFFF" Offset="0"/>
                    <GradientStop Color="#33FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#0DFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
            <Path.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.35"/>
            </Path.Effect>
            <Path.Data>
                <RectangleGeometry x:Name="ShapeGeo" Rect="125,6,190,34" RadiusX="17" RadiusY="17"/>
            </Path.Data>
        </Path>

        <!-- Glass sheen over the blurred backdrop (shown only when backdrop blur is active):
             white specular at the top, clear in the middle, gentle dark at the bottom for text contrast -->
        <Path x:Name="IslandTint" Width="440" Height="160" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.203125"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Data="{Binding Data, ElementName=IslandShape}">
            <Path.RenderTransform><ScaleTransform x:Name="IslandTintBreathScale"/></Path.RenderTransform>
            <Path.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#24FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.7"/>
                    <GradientStop Color="#2E0D0D14" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- Content is clipped to an identical, identically-animated rectangle. -->
        <Grid x:Name="IslandContent" Width="440" Height="160"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.Clip>
                <RectangleGeometry x:Name="ClipGeo" Rect="125,6,190,34" RadiusX="17" RadiusY="17"/>
            </Grid.Clip>

            <!-- ===== IDLE PANEL (nothing playing: time + date + constant battery on left if plugged in) ===== -->
            <!-- Starts visible (Opacity 1) because Idle is the startup mode. -->
            <Grid x:Name="IdlePanel" Width="190" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
                <!-- Constant battery charging indicator on the left side of the island (Apple iOS style) -->
                <Grid x:Name="IdleChargingBattery" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="12,0,0,0" Visibility="Collapsed" ToolTip="Battery Charging"
                      Cursor="Hand" MouseLeftButtonDown="OnIdleBatteryClick">
                    <Grid Width="25" Height="12" VerticalAlignment="Center">
                        <!-- Battery Outer Shell -->
                        <Border Width="23" Height="12" CornerRadius="3.2" HorizontalAlignment="Left"
                                Background="#1AFFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1">
                            <Grid>
                                <!-- Inner Fill Level (Animated by percent) -->
                                <Border x:Name="IdleBatteryFill" Width="18" Height="8.4" CornerRadius="1.8"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#34C759" Offset="0"/>
                                            <GradientStop Color="#30D158" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#30D158" Opacity="0.65"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Lightning Bolt Glyph INSIDE the Battery -->
                                <Path Data="M 3.8,0.5 L 1.5,4.2 L 3.5,4.2 L 2.2,8.0 L 6.5,3.5 L 4.5,3.5 Z"
                                      Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stretch="Uniform" Height="7" Width="5">
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="0.5" Direction="270" Color="#000000" Opacity="0.85"/>
                                    </Path.Effect>
                                </Path>
                            </Grid>
                        </Border>

                        <!-- Positive Terminal Nub on Right -->
                        <Border Width="1.8" Height="4.5" CornerRadius="0,1,1,0"
                                Background="#55FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Tabular digits: width stays constant when the minute changes (no jitter).
                     Time = bold white, date = medium, dimmed (iOS hierarchy). -->
                <TextBlock x:Name="IdleText" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Foreground="White" FontSize="13" Typography.NumeralAlignment="Tabular"
                           IsHitTestVisible="False">
                    <Run x:Name="TimeRun" FontWeight="Bold"/><Run x:Name="DateRun" FontWeight="Medium" Foreground="#8CFFFFFF"/>
                </TextBlock>
            </Grid>

            <!-- ===== COMPACT PANEL (playing: art + title + equalizer) ===== -->
            <Grid x:Name="CompactPanel" Width="250" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="22" Height="22" CornerRadius="7" Margin="10,0,8,0" VerticalAlignment="Center"
                        BorderBrush="#55FFFFFF" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>
                    <Border.Background>
                        <ImageBrush x:Name="ArtMini" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <TextBlock x:Name="TitleMini" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="White" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 4 glowing emerald equalizer bars with neon bloom; ScaleY animated from code (UpdateBars) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Height="14"
                            VerticalAlignment="Center" Margin="8,0,14,0">
                    <StackPanel.Effect>
                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#30D158" Opacity="0.65"/>
                    </StackPanel.Effect>
                    <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4EFA75" Offset="0"/>
                                <GradientStop Color="#28C951" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform><ScaleTransform x:Name="B1" ScaleY="0.4"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4EFA75" Offset="0"/>
                                <GradientStop Color="#28C951" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform><ScaleTransform x:Name="B2" ScaleY="0.4"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4EFA75" Offset="0"/>
                                <GradientStop Color="#28C951" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform><ScaleTransform x:Name="B3" ScaleY="0.4"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4EFA75" Offset="0"/>
                                <GradientStop Color="#28C951" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform><ScaleTransform x:Name="B4" ScaleY="0.4"/></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
            </Grid>

            <!-- ===== MEDIA PANEL (expanded) ===== -->
            <!-- Fixed size + centered, so it never re-flows while the island animates;
                 the island simply reveals/clips it. -->
            <Grid x:Name="MediaPanel" Width="400" Height="136"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                  Opacity="0" IsHitTestVisible="False">

                <!-- Dynamic Island Music Control (Matches Mockup with Top Mascot) -->

                <Grid x:Name="MediaMusicView" Width="368" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Row 0: Rounded-Square Album Art + Title/Artist + Playback Controls -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>



                        <!-- Album Art: Rounded Square (CornerRadius=8) -->

                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" ClipToBounds="True"

                                BorderBrush="#26FFFFFF" BorderThickness="0.8" Cursor="Hand" ToolTip="Open media player"

                                MouseLeftButtonDown="OnOpenSourceClick" VerticalAlignment="Center">

                            <Border.Effect>

                                <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270" Opacity="0.35" Color="#000000"/>

                            </Border.Effect>

                            <Grid>

                                <Border x:Name="ArtFallback" CornerRadius="8" Background="#161B26">

                                    <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"

                                               FontSize="18" Foreground="#829BFF" Opacity="0.75"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                                <Rectangle x:Name="ArtRect" RadiusX="8" RadiusY="8" Visibility="Collapsed">

                                    <Rectangle.Fill>

                                        <ImageBrush x:Name="Art" Stretch="UniformToFill"/>

                                    </Rectangle.Fill>

                                </Rectangle>

                            </Grid>

                        </Border>



                        <!-- Track Title & Artist -->

                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center" Cursor="Hand"

                                    ToolTip="Open media player" MouseLeftButtonDown="OnOpenSourceClick">

                            <TextBlock x:Name="TitleText" Text="Track Title" Foreground="White" FontSize="13.5"

                                       FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="195"

                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="ArtistText" Text="Artist Name" Foreground="#8E8E93"

                                       FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="195"/>

                        </StackPanel>



                        <!-- Right: Playback Controls (Prev, Play/Pause, Next) -->

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                            <!-- Prev Button -->

                            <Button x:Name="PrevBtn" Style="{StaticResource MediaIconBtn}" Width="28" Height="28" Margin="0,0,4,0"

                                    VerticalAlignment="Center"

                                    Click="OnPrev" ToolTip="Previous track" AutomationProperties.Name="Previous track">

                                <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"

                                           FontSize="13" Foreground="#6B7C96" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Button>



                            <!-- Play/Pause Button -->

                            <Button x:Name="PlayPauseBtn" Style="{StaticResource MediaIconBtn}" Width="32" Height="32" Margin="0,0,4,0"

                                    VerticalAlignment="Center"

                                    Click="OnPlayPause" ToolTip="Play / Pause" AutomationProperties.Name="Play or pause">

                                <TextBlock x:Name="PlayGlyph" Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"

                                           FontSize="16" FontWeight="Bold" Foreground="#829BFF"

                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Button>



                            <!-- Next Button -->

                            <Button x:Name="NextBtn" Style="{StaticResource MediaIconBtn}" Width="28" Height="28"

                                    VerticalAlignment="Center"

                                    Click="OnNext" ToolTip="Next track" AutomationProperties.Name="Next track">

                                <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"

                                           FontSize="13" Foreground="#6B7C96" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </Button>

                        </StackPanel>

                    </Grid>



                    <!-- Row 1: Scrub Progress Bar & Timestamps -->

                    <Grid Grid.Row="1" Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>



                        <!-- Elapsed Timestamp -->

                        <TextBlock x:Name="ElapsedText" Grid.Column="0" Text="0:00" Foreground="#8E8E93" FontSize="10.5"

                                   FontFamily="Segoe UI, Consolas" Typography.NumeralAlignment="Tabular"

                                   VerticalAlignment="Center" Margin="0,0,10,0"/>



                        <!-- Interactive Scrub Track with Soft Periwinkle Fill (#829BFF) -->

                        <Grid x:Name="ProgressBarContainer" Grid.Column="1" Height="14" VerticalAlignment="Center"

                              Background="Transparent" Cursor="Hand"

                              MouseLeftButtonDown="OnProgressMouseDown" MouseMove="OnProgressMouseMove"

                              MouseLeftButtonUp="OnProgressMouseUp">

                            <Border x:Name="ProgressBarTrack" Height="3.5" CornerRadius="1.75"

                                    Background="#26FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>

                            <Border x:Name="ProgressFill" Height="3.5" CornerRadius="1.75"

                                    Background="#829BFF" HorizontalAlignment="Left" VerticalAlignment="Center"

                                    Width="100"/>

                        </Grid>



                        <!-- Duration / Remaining Timestamp -->

                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="-0:00" Foreground="#8E8E93" FontSize="10.5"

                                   FontFamily="Segoe UI, Consolas" Typography.NumeralAlignment="Tabular"

                                   VerticalAlignment="Center" Margin="10,0,0,0"/>

                    </Grid>



                    <!-- Legacy and backward-compatibility elements (Hidden) -->

                    <StackPanel Visibility="Collapsed">

                        <Button x:Name="ShuffleBtn"><TextBlock x:Name="ShuffleGlyph"/></Button>

                        <Button x:Name="RepeatBtn"><TextBlock x:Name="RepeatGlyph"/></Button>

                        <Border x:Name="OutputDevicePill"><TextBlock x:Name="OutputDeviceText"/></Border>

                        <Border x:Name="CenterDragGrip"/>

                        <Button x:Name="MusicVolMinBtn"><TextBlock x:Name="MusicVolMinGlyph"/></Button>

                        <Grid x:Name="MusicVolSliderContainer">

                            <Border x:Name="MusicVolTrack"/>

                            <Border x:Name="MusicVolFill"/>

                            <Border x:Name="MusicVolThumb">

                                <Border.RenderTransform><ScaleTransform x:Name="MusicVolThumbScale"/></Border.RenderTransform>

                                <Border.Effect><DropShadowEffect x:Name="MusicVolThumbGlow"/></Border.Effect>

                            </Border>

                        </Grid>

                        <Button x:Name="MusicVolMaxBtn"/>

                        <Rectangle><Rectangle.RenderTransform><ScaleTransform x:Name="EB1"/></Rectangle.RenderTransform></Rectangle>

                        <Rectangle><Rectangle.RenderTransform><ScaleTransform x:Name="EB2"/></Rectangle.RenderTransform></Rectangle>

                        <Rectangle><Rectangle.RenderTransform><ScaleTransform x:Name="EB3"/></Rectangle.RenderTransform></Rectangle>

                        <Rectangle><Rectangle.RenderTransform><ScaleTransform x:Name="EB4"/></Rectangle.RenderTransform></Rectangle>

                    </StackPanel>

                </Grid>





                <!-- Scroll-wheel view 2: set / watch the focus timer. -->
                <StackPanel x:Name="TimerView" Grid.RowSpan="2" Visibility="Hidden"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="TMinus" Style="{StaticResource Ctl}" Content="&#xE738;" Click="OnTimerMinus"
                                AutomationProperties.Name="Less time"/>
                        <TextBlock Width="150" TextAlignment="Center" VerticalAlignment="Center" Foreground="White"
                                   FontWeight="SemiBold" Typography.NumeralAlignment="Tabular">
                            <Run x:Name="TimerBig" FontSize="40"/><Run x:Name="TimerUnit" FontSize="16"/>
                        </TextBlock>
                        <Button x:Name="TPlus" Style="{StaticResource Ctl}" Content="&#xE710;" Click="OnTimerPlus"
                                AutomationProperties.Name="More time"/>
                    </StackPanel>
                    <Button x:Name="TimerGo" Style="{StaticResource Ctl}" Width="130" Height="34" Margin="0,6,0,0"
                            FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Click="OnTimerGo"/>
                </StackPanel>

                <!-- Scroll-wheel view: big clock. Shown instead of the music UI, reset on collapse. -->
                <StackPanel x:Name="ClockView" Grid.RowSpan="2" Visibility="Hidden"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" Foreground="White" FontWeight="SemiBold">
                        <Run x:Name="BigTime" FontSize="48"/><Run x:Name="BigAmPm" FontSize="18"/>
                    </TextBlock>
                    <TextBlock x:Name="BigDate" HorizontalAlignment="Center" Foreground="#B3FFFFFF" FontSize="14"/>

                    <!-- Battery Percentage & Capsule Badge in Expanded Clock View -->
                    <StackPanel x:Name="ClockBatteryPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,5,0,0">
                        <!-- Neon green lightning bolt glyph if charging -->
                        <TextBlock x:Name="ClockBatteryBolt" Text="&#x26A1;" Foreground="#30D158"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="Collapsed"/>

                        <!-- Battery Shell Capsule -->
                        <Grid VerticalAlignment="Center" Margin="0,0,6,0">
                            <Border Width="22" Height="11" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="#1AFFFFFF" BorderBrush="#60FFFFFF" BorderThickness="1">
                                <Border x:Name="ClockBatteryFill" Width="18" Height="7" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                        Background="#30D158"/>
                            </Border>
                            <!-- Positive Terminal Nub -->
                            <Border Width="1.5" Height="4" CornerRadius="0,1,1,0"
                                    Background="#60FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Margin="0,0,-2,0"/>
                        </Grid>

                        <!-- Battery Percentage Text -->
                        <TextBlock x:Name="ClockBatteryPctText" Text="85%" Foreground="#CCFFFFFF"
                                   FontSize="12" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Scroll-wheel view 3: Clipboard history preview & quick-copy -->
                <Grid x:Name="ClipboardView" Grid.RowSpan="2" Visibility="Hidden" Margin="18,10,18,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Title, Count Badge, and Luxury History Capsule Button -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Electric Azure & Royal Sapphire jewel badge with specular rim -->
                            <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,8,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2997FF" Offset="0"/>
                                        <GradientStop Color="#0066FF" Offset="0.45"/>
                                        <GradientStop Color="#0047AB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#BBE0FF" Offset="0"/>
                                        <GradientStop Color="#4088FF" Offset="0.5"/>
                                        <GradientStop Color="#162060" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.40" Color="#0066FF"/>
                                </Border.Effect>
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Clipboard" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif" VerticalAlignment="Center"/>

                            <!-- Frosted crystal pill badge with ambient gradient and illuminated border -->
                            <Border CornerRadius="9" Padding="7.5,1.5" Margin="8,0,0,0" VerticalAlignment="Center" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                                        <GradientStop Color="#10FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                                        <GradientStop Color="#18FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <TextBlock x:Name="ClipCountBadge" Text="0 items" Foreground="#D5E0F0" FontSize="10.5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>

                        <!-- High-Quality History Capsule Button (BMW / Ferrari precision feel) -->
                        <Button x:Name="ClipHistoryBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource HistoryPillBtnStyle}"
                                Click="OnOpenClipboardHistory" ToolTip="Open full clipboard history"
                                AutomationProperties.Name="Open clipboard history">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11.5" Foreground="#67E8F9" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="History" FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="9" Foreground="#94A3B8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Bottom / Center Card: Multi-Stop Obsidian & Sapphire Glass Card with Specular Gradient & Tactile Copy Button -->
                    <Border Grid.Row="1" Margin="0,7,0,0" CornerRadius="14" Padding="13,8,9,8" BorderThickness="1.2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                <GradientStop Color="#4036445E" Offset="0"/>
                                <GradientStop Color="#30202A3C" Offset="0.32"/>
                                <GradientStop Color="#25161F2E" Offset="0.72"/>
                                <GradientStop Color="#300F1522" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                                <GradientStop Color="#85FFFFFF" Offset="0"/>
                                <GradientStop Color="#3B74B6" Offset="0.32"/>
                                <GradientStop Color="#22FFFFFF" Offset="0.72"/>
                                <GradientStop Color="#0DFFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.45" Color="#000000"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preview Text & Status Metadata -->
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="ClipPreviewText" Foreground="#F8FAFC" FontSize="12.5"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                           Text="No copied text yet"/>
                                <TextBlock x:Name="ClipMetaText" Foreground="#8B95A8" FontSize="10" Margin="0,2,0,0"
                                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                           Text="Copied text appears here automatically"/>
                            </StackPanel>

                            <!-- Tactile Jewel Quick-Copy Button -->
                            <Button x:Name="ClipQuickCopyBtn" Grid.Column="1"
                                    Style="{StaticResource QuickCopyTactileBtnStyle}" Click="OnQuickCopyLatest"
                                    ToolTip="Copy to clipboard" AutomationProperties.Name="Quick copy latest text">
                                <TextBlock x:Name="ClipQuickCopyGlyph" Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13.5" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== VOLUME PANEL (brief HUD) ===== -->
            <!-- Focus timer pill: compact countdown with closely integrated music visualizer bars. -->
            <Grid x:Name="TimerPanel" Width="180" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                  Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Timer countdown -->
                    <TextBlock VerticalAlignment="Center" Foreground="White"
                               FontSize="13.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular">
                        <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#FF9F0A" Text="&#xE916;"/><Run Text=" "/><Run x:Name="TimerRun"/>
                    </TextBlock>

                    <!-- Compact music visualizer bars with neon emerald glow placed close to the countdown -->
                    <StackPanel x:Name="TimerMusicBars" Orientation="Horizontal" Height="14"
                                VerticalAlignment="Center" Margin="9,0,0,0" Visibility="Collapsed">
                        <StackPanel.Effect>
                            <DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#30D158" Opacity="0.65"/>
                        </StackPanel.Effect>
                        <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4EFA75" Offset="0"/>
                                    <GradientStop Color="#28C951" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform><ScaleTransform x:Name="TB1" ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4EFA75" Offset="0"/>
                                    <GradientStop Color="#28C951" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform><ScaleTransform x:Name="TB2" ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4EFA75" Offset="0"/>
                                    <GradientStop Color="#28C951" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform><ScaleTransform x:Name="TB3" ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" Margin="1.5,0" RadiusX="1.5" RadiusY="1.5"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4EFA75" Offset="0"/>
                                    <GradientStop Color="#28C951" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform><ScaleTransform x:Name="TB4" ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Notification card: app badge + title + message. Shown by Mode.Notify. -->
            <Grid x:Name="NotifyPanel" Width="360" Height="70"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                  Opacity="0" IsHitTestVisible="False" Cursor="Hand" ToolTip="Click to dismiss">
                <StackPanel Orientation="Horizontal" Margin="14,0,20,0" VerticalAlignment="Center">
                    <Border x:Name="NotifyBadge" Width="42" Height="42" CornerRadius="11" Background="#45384252"
                            BorderBrush="#40FFFFFF" BorderThickness="1">
                        <TextBlock x:Name="NotifyIcon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"/>
                    </Border>
                    <StackPanel Width="266" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotifyTitle" Foreground="White" FontSize="14" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NotifyText" Foreground="#B3FFFFFF" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid x:Name="VolumePanel" Width="280" Height="44"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="VolIcon" Width="22" Margin="18,0,10,0" VerticalAlignment="Center"
                           Foreground="White" FontSize="18"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>

                <!-- Track + fill with glass channel and luminous gradient; fill width = track width * level (set in code) -->
                <Border x:Name="VolTrack" Grid.Column="1" Height="7" CornerRadius="3.5"
                        Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="0.8" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="90" Opacity="0.25" Color="#000000"/>
                    </Border.Effect>
                    <Border x:Name="VolFill" Width="0" CornerRadius="3.5" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#93C5FD" Offset="0"/>
                                <GradientStop Color="#FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>

                <TextBlock x:Name="VolPct" Grid.Column="2" Width="40" Margin="10,0,18,0"
                           VerticalAlignment="Center" TextAlignment="Right"
                           Foreground="White" FontSize="13"/>
            </Grid>

            <!-- ===== CHARGING PANEL (Apple-inspired Charger Plug-in HUD) ===== -->
            <Grid x:Name="ChargingPanel" Width="260" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Battery percentage & Charging status label -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="ChargePctText" Foreground="White" FontSize="13.5" FontWeight="Bold"
                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="85%"/>
                    <TextBlock x:Name="ChargeStatusText" Text="Charging" Foreground="#30D158" FontSize="11.5"
                               FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#30D158" Opacity="0.65"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Right: High-Precision Battery Capsule with Neon Lightning Bolt -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Glowing Lightning Bolt Glyph -->
                    <TextBlock x:Name="ChargeBolt" Text="&#x26A1;"
                               FontFamily="Segoe UI Variable Display, Segoe UI, Segoe Fluent Icons"
                               FontSize="13.5" FontWeight="Bold" Foreground="#30D158"
                               VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#30D158" Opacity="0.85"/>
                        </TextBlock.Effect>
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:Name="ChargeBoltScale" ScaleX="1" ScaleY="1" CenterX="6.5" CenterY="6.5"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- Horizontal Battery Shell -->
                    <Grid VerticalAlignment="Center">
                        <!-- Battery Body -->
                        <Border x:Name="ChargeShell" Width="26" Height="13" CornerRadius="3.5"
                                Background="#1AFFFFFF" BorderBrush="#60FFFFFF" BorderThickness="1.2">
                            <!-- Inner Fill Level -->
                            <Border x:Name="ChargeFill" Width="18" Height="9" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1.2,0,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#34C759" Offset="0"/>
                                        <GradientStop Color="#30D158" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#30D158" Opacity="0.75"/>
                                </Border.Effect>
                            </Border>
                        </Border>

                        <!-- Positive Terminal Nub -->
                        <Border Width="2" Height="5" CornerRadius="0,1,1,0"
                                Background="#60FFFFFF" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,-2.5,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ===== PIN TARGET PANEL (App Drag-to-Pin Activation) ===== -->
            <Grid x:Name="PinPanel" Width="280" Height="34"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Luminous Pin Jewel Icon with Specular Ring -->
                <Border x:Name="PinBadge" Width="22" Height="22" CornerRadius="7" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFB300" Offset="0"/>
                            <GradientStop Color="#FF8F00" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect x:Name="PinBadgeGlow" BlurRadius="8" ShadowDepth="0" Color="#FFB300" Opacity="0.75"/>
                    </Border.Effect>
                    <TextBlock x:Name="PinBadgeGlyph" Text="&#xE840;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Center: Prompt Title ("Drag here to pin" -> "Drop to pin on top") -->
                <TextBlock x:Name="PinPromptTitle" Grid.Column="1" Text="Drag here to pin"
                           Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                           Margin="8,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <!-- Right: High-Precision Target App Pill Badge -->
                <Border x:Name="PinTargetPill" Grid.Column="2" CornerRadius="8" Padding="7,2" Margin="0,0,8,0"
                        VerticalAlignment="Center" Background="#26FFFFFF" BorderBrush="#45FFFFFF" BorderThickness="1">
                    <TextBlock x:Name="PinTargetAppName" Text="Window" Foreground="#E2E8F0" FontSize="11"
                               FontWeight="Medium" FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                </Border>
            </Grid>

            <Grid x:Name="MascotPanel" Width="102" Height="53" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform x:Name="MascotFadeScale" ScaleX="0.9" ScaleY="0.9"/></Grid.RenderTransform>
                <Canvas x:Name="MascotHeadphones" Width="76" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                    <Canvas.CacheMode>
                        <BitmapCache SnapsToDevicePixels="False" EnableClearType="False"/>
                    </Canvas.CacheMode>
                    <Canvas.Effect>
                        <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="#829BFF" Opacity="0.6"/>
                    </Canvas.Effect>
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="MascotHeadphonesBob"/>
                    </Canvas.RenderTransform>
                    <!-- Inner mesh canopy -->
                    <Path Data="M 11,11.5 C 14,2 62,2 65,11.5" Stroke="#829BFF" StrokeThickness="1.4" Opacity="0.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    
                    <!-- Outer stainless steel arch -->
                    <Path Data="M 8,11 C 11,-1 65,-1 68,11" Stroke="#F1F5F9" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                    <!-- Hinge connectors -->
                    <Border Canvas.Left="6" Canvas.Top="9" Width="4" Height="3.5" CornerRadius="1.2" Background="#CBD5E1"/>
                    <Border Canvas.Left="66" Canvas.Top="9" Width="4" Height="3.5" CornerRadius="1.2" Background="#CBD5E1"/>

                    <!-- Left Earcup Shell -->
                    <Border Canvas.Left="3.5" Canvas.Top="11.5" Width="8.5" Height="17.5" CornerRadius="4.25" BorderBrush="#829BFF" BorderThickness="1.2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#40507D" Offset="0"/>
                                <GradientStop Color="#1C2338" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Width="2.5" Height="7" CornerRadius="1.2" Background="#A6B6FF" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                    </Border>

                    <!-- Left Earcup Inner Cushion -->
                    <Border Canvas.Left="10" Canvas.Top="13" Width="2.5" Height="14.5" CornerRadius="1.2" Background="#D1DCFF" Opacity="0.95"/>

                    <!-- Right Earcup Shell -->
                    <Border Canvas.Left="64" Canvas.Top="11.5" Width="8.5" Height="17.5" CornerRadius="4.25" BorderBrush="#829BFF" BorderThickness="1.2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#40507D" Offset="0"/>
                                <GradientStop Color="#1C2338" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border Width="2.5" Height="7" CornerRadius="1.2" Background="#A6B6FF" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                    </Border>

                    <!-- Right Earcup Inner Cushion -->
                    <Border Canvas.Left="63.5" Canvas.Top="13" Width="2.5" Height="14.5" CornerRadius="1.2" Background="#D1DCFF" Opacity="0.95"/>
                </Canvas>
                <Canvas x:Name="MascotShades" Width="52" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"><Canvas.RenderTransform><TranslateTransform x:Name="MascotShadesMove"/></Canvas.RenderTransform>
                    <Border Canvas.Left="0" Canvas.Top="3" Width="16" Height="13" CornerRadius="4" Background="#A8343C58" BorderBrush="#FF829BFF" BorderThickness="1.2"><Path Data="M 3,2 L 7,2 L 3,7" Stroke="#99FFFFFF" StrokeThickness="0.8"/></Border>
                    <Border Canvas.Left="36" Canvas.Top="3" Width="16" Height="13" CornerRadius="4" Background="#A8343C58" BorderBrush="#FF829BFF" BorderThickness="1.2"><Path Data="M 3,2 L 7,2 L 3,7" Stroke="#99FFFFFF" StrokeThickness="0.8"/></Border>
                    <Path Data="M 16,9 Q 26,5 36,9" Stroke="#FF829BFF" StrokeThickness="1.2"/>
                </Canvas>
                <Canvas x:Name="MascotBow" Width="20" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="72,12,0,0" Visibility="Collapsed" IsHitTestVisible="False"><Canvas.RenderTransform><TranslateTransform x:Name="MascotBowMove"/></Canvas.RenderTransform>
                    <Path Data="M 9,7 C 5,0 1,1 2,5 C 2,8 5,9 9,8 Z" Fill="#FFFF70A8"/>
                    <Path Data="M 10,7 C 14,0 18,1 17,5 C 17,8 14,9 10,8 Z" Fill="#FFFF70A8"/>
                    <Ellipse Canvas.Left="8" Canvas.Top="5" Width="4" Height="4" Fill="#FFFF9BC2"/>
                </Canvas>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                    <Border x:Name="MascotEyeLeftShape" Width="9" Height="15" CornerRadius="8" Background="#829BFF" Margin="0,0,24,0"><Border.Effect><DropShadowEffect x:Name="MascotEyeLeftGlow" BlurRadius="10" ShadowDepth="0" Color="#829BFF" Opacity="0.9"/></Border.Effect><Border.RenderTransform><TranslateTransform x:Name="MascotEyeLeft"/></Border.RenderTransform></Border>
                    <Border x:Name="MascotEyeRightShape" Width="9" Height="15" CornerRadius="8" Background="#829BFF"><Border.Effect><DropShadowEffect x:Name="MascotEyeRightGlow" BlurRadius="10" ShadowDepth="0" Color="#829BFF" Opacity="0.9"/></Border.Effect><Border.RenderTransform><TranslateTransform x:Name="MascotEyeRight"/></Border.RenderTransform></Border>
                </StackPanel>
                <StackPanel x:Name="MascotSmileEyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Path x:Name="MascotSmileLeftShape" Width="9" Height="8" Data="M 1,7 Q 4.5,1 8,7" Stroke="#829BFF" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,19,0">
                        <Path.Effect><DropShadowEffect x:Name="MascotSmileLeftGlow" BlurRadius="16" ShadowDepth="0" Color="#829BFF" Opacity="1"/></Path.Effect>
                        <Path.RenderTransform><TranslateTransform x:Name="MascotSmileLeft"/></Path.RenderTransform>
                    </Path>
                    <Path x:Name="MascotSmileRightShape" Width="9" Height="8" Data="M 1,7 Q 4.5,1 8,7" Stroke="#829BFF" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Effect><DropShadowEffect x:Name="MascotSmileRightGlow" BlurRadius="16" ShadowDepth="0" Color="#829BFF" Opacity="1"/></Path.Effect>
                        <Path.RenderTransform><TranslateTransform x:Name="MascotSmileRight"/></Path.RenderTransform>
                    </Path>
                </StackPanel>
                <Canvas x:Name="MascotSleepZ" Width="24" Height="29" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,12,0" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="MascotSleepZ1" Canvas.Left="0" Canvas.Top="18" Text="z" Foreground="#9AAEFF" FontSize="9" FontWeight="SemiBold"><TextBlock.RenderTransform><TranslateTransform x:Name="MascotSleepZ1Move"/></TextBlock.RenderTransform></TextBlock>
                    <TextBlock x:Name="MascotSleepZ2" Canvas.Left="6" Canvas.Top="11" Text="z" Foreground="#9AAEFF" FontSize="12" FontWeight="SemiBold"><TextBlock.RenderTransform><TranslateTransform x:Name="MascotSleepZ2Move"/></TextBlock.RenderTransform></TextBlock>
                    <TextBlock x:Name="MascotSleepZ3" Canvas.Left="12" Canvas.Top="4" Text="Z" Foreground="#9AAEFF" FontSize="15" FontWeight="SemiBold"><TextBlock.RenderTransform><TranslateTransform x:Name="MascotSleepZ3Move"/></TextBlock.RenderTransform></TextBlock>
                </Canvas>
            </Grid>
        </Grid>

        <!-- Listening glow: soft ring on the mascot pill edge + bright comets circling it -->
        <Grid x:Name="MascotListenGlow" Width="102" Height="53" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="MascotListenGlowScale"/></Grid.RenderTransform>
            <Rectangle x:Name="MascotGlowRing" RadiusX="26.5" RadiusY="26.5" Stroke="#829BFF" StrokeThickness="2">
                <Rectangle.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#829BFF" Opacity="0.9"/></Rectangle.Effect>
            </Rectangle>
            <Rectangle x:Name="MascotGlowComet" RadiusX="26.5" RadiusY="26.5" Stroke="#D6DEFF" StrokeThickness="2" StrokeDashArray="6 27" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Rectangle.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFFFFF" Opacity="0.9"/></Rectangle.Effect>
            </Rectangle>
        </Grid>

        <!-- Listening ripple: soft rings expand outward from the pill and fade -->
        <Grid x:Name="MascotListenRipple" Width="102" Height="53" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Rectangle x:Name="MascotRipple1" RadiusX="26.5" RadiusY="26.5" Stroke="#9BB0FF" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform x:Name="MascotRipple1Scale"/></Rectangle.RenderTransform>
                <Rectangle.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#829BFF" Opacity="0.9"/></Rectangle.Effect>
            </Rectangle>
            <Rectangle x:Name="MascotRipple2" RadiusX="26.5" RadiusY="26.5" Stroke="#C9B8FF" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><ScaleTransform x:Name="MascotRipple2Scale"/></Rectangle.RenderTransform>
                <Rectangle.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#B79BFF" Opacity="0.9"/></Rectangle.Effect>
            </Rectangle>
        </Grid>

        <!-- Listening rainbow: colour gradient ring that spins around the pill edge -->
        <Grid x:Name="MascotListenRainbow" Width="102" Height="53" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Visibility="Collapsed" IsHitTestVisible="False">
            <Rectangle x:Name="MascotRainbowRing" RadiusX="26.5" RadiusY="26.5" StrokeThickness="2.5">
                <Rectangle.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <LinearGradientBrush.RelativeTransform><RotateTransform x:Name="MascotRainbowRot" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#FF6EC7" Offset="0"/><GradientStop Color="#7AA2FF" Offset="0.3"/><GradientStop Color="#5CF2D6" Offset="0.55"/><GradientStop Color="#FFD36E" Offset="0.8"/><GradientStop Color="#FF6EC7" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Stroke>
                <Rectangle.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#9B8CFF" Opacity="0.8"/></Rectangle.Effect>
            </Rectangle>
        </Grid>

        <Canvas x:Name="MascotListenWaves" Width="154" Height="53" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Visibility="Collapsed" IsHitTestVisible="False">
            <Path x:Name="MascotListenWaveLeftInner" Stroke="#829BFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,0"/>
            <Path x:Name="MascotListenWaveLeftOuter" Stroke="#A6B6FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,0"/>
            <Path x:Name="MascotListenWaveRightInner" Stroke="#829BFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,0"/>
            <Path x:Name="MascotListenWaveRightOuter" Stroke="#A6B6FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0,0"/>
        </Canvas>

        <!-- Privacy Indicator Dots (Mic = Orange, Camera = Green) -->
        <StackPanel x:Name="PrivacyPanel" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    IsHitTestVisible="False" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="PrivacyShift" X="295" Y="20"/>
            </StackPanel.RenderTransform>
            <!-- Camera indicator (Green) -->
            <Ellipse x:Name="CamDot" Width="6" Height="6" Fill="#30D158" Margin="0,0,4,0" Visibility="Collapsed">
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#30D158" Opacity="0.85"/></Ellipse.Effect>
            </Ellipse>
            <!-- Microphone indicator (Orange) -->
            <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#FF9F0A" Visibility="Collapsed">
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FF9F0A" Opacity="0.85"/></Ellipse.Effect>
            </Ellipse>
        </StackPanel>
    </Grid>
</Window>









