<Window x:Class="DynamicIsland.ClipboardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard History" Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Base Close Icon Button -->
        <Style x:Key="CloseIconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#B0B5C4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="15" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2A2F3D" Offset="0"/>
                                    <GradientStop Color="#171A24" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                                    <GradientStop Color="#18FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3D4559" Offset="0"/>
                                            <GradientStop Color="#222736" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#90FFFFFF" Offset="0"/>
                                            <GradientStop Color="#35FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#12141C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Action Pill Button (e.g. Clear) -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FFA49D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="15" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#381D20" Offset="0"/>
                                    <GradientStop Color="#201013" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#75FF453A" Offset="0"/>
                                    <GradientStop Color="#30FF453A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#522429" Offset="0"/>
                                            <GradientStop Color="#321418" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#B0FF453A" Offset="0"/>
                                            <GradientStop Color="#55FF453A" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#180C0E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimalist scrollbar style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#35FFFFFF" CornerRadius="3"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border x:Name="Card" Width="422" CornerRadius="28" BorderThickness="1.2" Padding="22,20,22,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                    <GradientStop Color="#D0202738" Offset="0"/>
                    <GradientStop Color="#C0131722" Offset="0.35"/>
                    <GradientStop Color="#B40D1017" Offset="0.75"/>
                    <GradientStop Color="#C207080D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.85,1">
                    <GradientStop Color="#85FFFFFF" Offset="0"/>
                    <GradientStop Color="#3B74B6" Offset="0.35"/>
                    <GradientStop Color="#20FFFFFF" Offset="0.75"/>
                    <GradientStop Color="#0AFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="12" Direction="270" Opacity="0.60" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale"/>
                    <TranslateTransform x:Name="CardShift"/>
                </TransformGroup>
            </Border.RenderTransform>

            <StackPanel>
                <!-- ==================== HEADER ==================== -->
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Apple Blue Accent Badge Icon -->
                        <Border Width="34" Height="34" CornerRadius="11" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2997FF" Offset="0"/>
                                    <GradientStop Color="#0066FF" Offset="0.45"/>
                                    <GradientStop Color="#0047AB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#BBE0FF" Offset="0"/>
                                    <GradientStop Color="#4088FF" Offset="0.5"/>
                                    <GradientStop Color="#162060" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1.5" Direction="270" Opacity="0.45" Color="#0066FF"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="15"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Clipboard History" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="SubtitleText" Text="Last 10 copied texts • Click to copy" FontSize="11.5" Foreground="#8E8E93" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Header Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ClearBtn" Style="{StaticResource PillBtn}" Content="Clear" Margin="0,0,8,0"
                                AutomationProperties.Name="Clear clipboard history"/>
                        <Button x:Name="CloseBtn" Style="{StaticResource CloseIconBtn}"
                                Content="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="11"
                                AutomationProperties.Name="Close dialog"/>
                    </StackPanel>
                </Grid>

                <!-- Thin frosted divider -->
                <Rectangle Height="1" Fill="#18FFFFFF" Margin="0,14,0,0"/>

                <!-- ==================== CLIPBOARD LIST ==================== -->
                <ScrollViewer x:Name="ListScroll" MaxHeight="390" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ItemsStack"/>
                </ScrollViewer>

                <!-- Empty State Placeholder -->
                <Border x:Name="EmptyState" Visibility="Collapsed" Margin="0,20,0,10" Padding="16,28">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#55FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No copied texts yet" FontSize="14.5" FontWeight="SemiBold" Foreground="#99FFFFFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Text you copy in any app will appear here automatically." FontSize="11.5" Foreground="#55FFFFFF"
                                   TextAlignment="Center" Margin="0,4,0,0" MaxWidth="280" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ==================== FOOTER ==================== -->
                <Grid Margin="0,14,0,0">
                    <TextBlock Text="Tip: Press 1–9 to copy item • Esc to exit" FontSize="11" Foreground="#555866"
                               HorizontalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
