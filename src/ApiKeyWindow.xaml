<Window x:Class="DynamicIsland.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nixi Island — Gemini API Key"
        Width="500" Height="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#111318"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#2A2E38" BorderThickness="1" Background="#111318">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#0D0F14" MouseLeftButtonDown="OnTitlebarMouseDown">
                <Grid>
                    <TextBlock Text="AI Assistant Setup — Gemini API Key" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="#E8EAF2" FontWeight="SemiBold" FontSize="13"/>
                    <Button Content="✕" Style="{StaticResource TitleBtnClose}" HorizontalAlignment="Right" Click="OnCloseClick" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="24,20,24,20">
                <TextBlock Text="Google Gemini API Key" Style="{StaticResource CardTitle}" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="To enable Nixi's voice recognition, conversation, and multimodal tools, please enter your Gemini API key."
                           Foreground="#9CA3AF" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <!-- Link to get key -->
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Don't have a Gemini API key?" Foreground="#E8EAF2" FontSize="12" FontWeight="Medium"/>
                            <TextBlock Text="Free API keys can be created in Google AI Studio." Foreground="#6E7686" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Get free key ↗" Style="{StaticResource Chip}" Click="OnGetKeyClick" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Input Box -->
                <TextBlock Text="API Key" Foreground="#9CA3AF" FontSize="11.5" FontWeight="SemiBold" Margin="2,0,0,6"/>
                <TextBox x:Name="TxtApiKey" Style="{StaticResource Field}" Height="38" Padding="10,8"
                         FontFamily="Consolas" FontSize="13" Text="" TextChanged="OnApiKeyTextChanged"/>
                <TextBlock x:Name="LblStatus" Text="" Foreground="#EF4444" FontSize="11.5" Margin="2,4,0,0" Visibility="Collapsed"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Skip for now" Style="{StaticResource Chip}" Click="OnSkipClick" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSave" Content="Save &amp; Continue" Style="{StaticResource AccentBtn}" Click="OnSaveClick" MinWidth="130" Height="36"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

