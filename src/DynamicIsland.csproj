<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DynamicIsland</RootNamespace>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NuGetAudit>false</NuGetAudit>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Authors>Akhin (SPARK-REX)</Authors>
    <Company>Akhin (SPARK-REX)</Company>
    <Product>Dynamic Island for Windows</Product>
    <RepositoryUrl>https://github.com/SPARK-REX/Dynamic-island</RepositoryUrl>
    <PackageProjectUrl>https://github.com/SPARK-REX</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 Akhin (SPARK-REX)</Copyright>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;publish\**;release_package\**;website\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\app.ico" />
    <None Update="assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="gemini.key" Condition="Exists('gemini.key')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="gemini.key.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="false" />
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.MinThreads" Value="4" />
    <RuntimeHostConfigurationOption Include="System.Windows.Media.DisableMultimonitorDisplayClipping" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.14" />
  </ItemGroup>
</Project>
